# PostgreSQL connection string
# Local: create DB named "mirrorfit" first: createdb mirrorfit
DATABASE_URL=postgresql://postgres:password@localhost/mirrorfit

# Scraper settings
SCRAPE_SCHEDULE=0 2 * * *
OUTPUT_DIR=./output
MAX_CONCURRENCY=5
LOG_LEVEL=INFO
USER_AGENT=Mozilla/5.0 (compatible; MirrorFitBot/1.0)
REQUEST_DELAY_MS=1500

# API keys
OPENAI_API_KEY=your-openai-key-here
APIFY_API_KEY=your-apify-key-here
